# Frontend (Next.js) — LangGraph deployment
NEXT_PUBLIC_DEPLOYMENT_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=blogwriter
NEXT_PUBLIC_LANGSMITH_API_KEY=

# Tavily API Key 
TAVILY_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Blog-Writer"

# Google API Key
GOOGLE_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# LLM Model
LLM_CHOICE="provider:model_name" 
# ## Below are some examples ## 
# "ollama:kimi-k2.5:cloud" 
# "google_genai:gemini-3.1-pro-preview"
# "openai:gpt-5.4-mini"
# "openrouter:deepseek/deepseek-v4-flash"
