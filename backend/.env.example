# Backend only. langgraph.json loads this file into the Python process.
# Frontend vars live in frontend/.env.local.example.

# Tavily API Key
TAVILY_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Blog-Writer"

# Cover images
# IMAGE_PROVIDER: pollinations (default, gen API + FLUX.1.1-pro) |
#                 cloudflare (Workers AI FLUX.1 schnell, free tier) |
#                 gemini (needs GOOGLE_API_KEY + billing)
IMAGE_PROVIDER=pollinations

# Pollinations gen API key — used by the default cover provider.
POLLONATION_API_KEY=

# Cloudflare Workers AI: Workers & Pages > Account ID, plus an API token with
# the "Workers AI: Read" permission. Free tier covers ~170 covers/day.
# Only needed for IMAGE_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google API Key (only needed for IMAGE_PROVIDER=gemini)
GOOGLE_API_KEY=


# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# LLM Model
LLM_CHOICE="provider:model_name"
# ## Below are some examples ##
# "ollama:kimi-k2.5:cloud"
# "google_genai:gemini-3.1-pro-preview"
# "openai:gpt-5.4-mini"
# "openrouter:deepseek/deepseek-v4-flash"
