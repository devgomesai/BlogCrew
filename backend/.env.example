# Backend only. langgraph.json loads this file into the Python process.
# Frontend vars live in frontend/.env.local.example.

# Tavily API Key
TAVILY_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Blog-Writer"

# Cover images
# Generated with the OpenRouter Images API (Recraft V4.1 Flash).
# Only needs OPENROUTER_API_KEY below.

# Openrouter API Key — used for the LLM (LLM_CHOICE) and cover image generation.
OPENROUTER_API_KEY=

# Google API Key (optional, not needed for covers)
GOOGLE_API_KEY=


# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# LLM Model
LLM_CHOICE="provider:model_name"
# ## Below are some examples ##
# "ollama:kimi-k2.5:cloud"
# "google_genai:gemini-3.1-pro-preview"
# "openai:gpt-5.4-mini"
# "openrouter:deepseek/deepseek-v4-flash"
# "openrouter:openrouter/free"
